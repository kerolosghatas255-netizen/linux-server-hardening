#!/usr/bin/env bash

set -euo pipefail
umask 077

BACKUP_DIR="/var/backups/hardening"
LOG_FILE="/var/log/hardening-backup.log"
TIMESTAMP="$(date '+%Y-%m-%d_%H-%M-%S')"
BACKUP_FILE="${BACKUP_DIR}/hardening-${TIMESTAMP}.tar.gz"

SOURCES=(
    /etc/ssh/sshd_config
    /etc/ssh/sshd_config.d
    /home/kero/.ssh/authorized_keys
    /etc/fail2ban
    /etc/ufw
    /etc/nginx
    /etc/apt/apt.conf.d/20auto-upgrades
    /etc/apt/apt.conf.d/50unattended-upgrades
    /var/www/html
    /usr/local/bin/security-status
    /usr/local/bin/server-health
    /usr/local/bin/hardening-backup
    /etc/systemd/system/hardening-backup.service
    /etc/systemd/system/hardening-backup.timer
)

mkdir -p "$BACKUP_DIR"

{
    echo "[$(date '+%F %T')] Starting backup"

    tar -czf "$BACKUP_FILE" "${SOURCES[@]}"

    echo "[$(date '+%F %T')] Backup created: $BACKUP_FILE"

    # Keep only the newest 7 backups
    ls -1t "$BACKUP_DIR"/hardening-*.tar.gz 2>/dev/null \
        | tail -n +8 \
        | xargs -r rm -f

    echo "[$(date '+%F %T')] Retention cleanup completed"
    echo
} >> "$LOG_FILE" 2>&1
